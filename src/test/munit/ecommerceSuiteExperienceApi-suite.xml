	<flow name="duplicateEmail_helperFlow2" doc:id="4b8d6317-d9cc-4686-b8ef-18a64f9865e6" >
		<http:listener doc:name="Listener" doc:id="5450113a-b5da-4d63-80e8-76be455c1918" config-ref="HTTP_Listener_config_munit" path="/auth/register">
			<http:error-response statusCode="#[vars.httpStatus default 500]" />
		</http:listener>
		<raise-error doc:name="APP:DUPLICATE_EMAIL" doc:id="05f5bb76-7a39-4bce-90ad-6b3d3f2e271e" type="APP:DUPLICATE_EMAIL"/>
		<error-handler >
			<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="91891aa6-d3ba-49d1-89a1-fa01919d8ea5" type="APP:DUPLICATE_EMAIL">
				<set-variable value="409" doc:name="httpStatus" doc:id="6af8a93d-63d7-42de-ae92-1d7d93db13ac" variableName="httpStatus"/>
			</on-error-propagate>
		</error-handler>
	</flow>
