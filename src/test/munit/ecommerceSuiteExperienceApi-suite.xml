				</munit-tools:with-attributes>
				<munit-tools:then-call flow="duplicateEmail_helperFlow" />
			</munit-tools:mock-when>
			<munit:set-event doc:name="Set Event" doc:id="72fb9f8f-a221-416d-af6f-f9be63549edc" >
				<munit:payload value='#[output application/json&#10;---&#10;{&#10;  "firstName": "Tom",&#10;  "lastName": "holland",&#10;  "email": "tomholland@gmail.com",&#10;  "phoneNo": "7894896498",&#10;  "city": "nagpur",&#10;  "role": "seller",&#10;  "password": "tom"&#10;}]' />
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<try doc:name="Try" doc:id="4bcfc400-6d40-4d09-ad52-4cc18910a78e" >
				<flow-ref doc:name="Flow-ref to post:\auth\register:application\json:ecommerceSuiteExperienceApi-config" doc:id="d2d695bd-159d-4744-9d19-e5f3988c07d1" name="post:\auth\register:application\json:ecommerceSuiteExperienceApi-config" />
				<error-handler >
					<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="d6f2b7b0-12db-40d4-9cbc-9f765dffddd8" type="ANY">
						<logger level="INFO" doc:name="Logger" doc:id="b73e3d7b-8fb1-44eb-8e4b-d401fcae494d" message='#["Catching errors"]'/>
					</on-error-continue>
				</error-handler>
			</try>
		</munit:execution>
		<munit:validation >
			<munit-tools:assert-equals doc:name="Assert equals" doc:id="1758064f-42be-4731-86f1-c661b5d2cf04" actual="#[payload]" expected='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;	message:"Email already registered. Please use a different email"&#10;}]'/>
		</munit:validation>
	</munit:test>


