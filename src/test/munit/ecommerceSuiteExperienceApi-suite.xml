	<munit:test name="post:\auth\register_duplicateEmail" doc:id="76e934eb-6e91-41d0-bfe8-fc1b2c16981e">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="duplicateEmail_helperFlow2" />

    </munit:enable-flow-sources>
		<munit:behavior >
			<munit-tools:mock-when doc:name="/process/auth/register" doc:id="a3a913e0-3fda-4e83-a5e7-2ee30e9f3d19" processor="http:request">
				<munit-tools:with-attributes >
