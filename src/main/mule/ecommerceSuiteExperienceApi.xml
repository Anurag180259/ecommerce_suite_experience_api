---
{
	"storeId" : attributes.uriParams.storeId
}]]]></http:uri-params>
        </http:request>
        <choice doc:name="Choice" doc:id="0e7258bd-bf62-41f3-a9a7-d7aa8dbd098a">
            <when expression="#[isEmpty(payload)]">
                <ee:transform doc:name="Transform Message" doc:id="f787384e-3b04-4a4e-9fc6-a8b7c827fb65">
