    <flow name="get:\products:ecommerceSuiteExperienceApi-config">
        <logger level="INFO" message="Request to get the products by filters received. calling process API" />
        <http:request method="GET" doc:name="GET/products" doc:id="ef62a44f-7ce5-40d3-a7f5-2f80b3346cb8" config-ref="HTTP_Request_configuration" path="/products">
            <http:query-params><![CDATA[#[output application/java
---
{
	"brand" : attributes.queryParams.brand,
	"category":attributes.queryParams.category,
	"subCategory":attributes.queryParams.subCategory,
	"maxPrice":attributes.queryParams.maxPrice,
	"minPrice":attributes.queryParams.minPrice,
	"inStock":attributes.queryParams.inStock,
	"minRatings":attributes.queryParams.minRatings,
	"storeName":attributes.queryParams.storeName
}filterObject ((value, key) -> value != null)]]]></http:query-params>
        </http:request>
        <ee:transform doc:name="Transform Message" doc:id="1d1751bf-4c36-42e4-9ee0-451e4cb964d5">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
var a =payload map{
	"storeName": $.storeName,
        "productName": $.productName,
        "brand": $.brandName,
        "productId": $.productId,
        "storeId": "ST-7ef50f",
        "stock": 23,
        "price": 5300,
        "category": "Clothes",
        "subCategory": "Saree",
        "rating": 0,
        "noOfReviews": 0,
        "details": "This is an Ethnic saree. Great for festive season and traditional functions",
        stockStatus: if($.stock>0) "inStock" else "notInStock"
}groupBy $.stockStatus
output application/json
---
{
	totalProducts:sizeOf(payload),
	inStockCount:sizeOf(a.inStock),
	notInStockCount:sizeOf(a.notInStock),
	avgPrice:sum(payload.price)/sizeOf(payload) default null,
	products:a mapObject(value, key)->{
		(key):value map((item) -> item - ("stockStatus"))
	}
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>
    <flow name="get:\stores\(storeId)\products:ecommerceSuiteExperienceApi-config">
        <logger level="INFO" message="Request to get all the products by store id received. calling process flow" />
